# ---- Server ----
PORT=4000
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# ---- Database: choose ONE driver ----
# DB_DRIVER=postgres  OR  DB_DRIVER=mongo
DB_DRIVER=postgres

# PostgreSQL (used when DB_DRIVER=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/househunt

# MongoDB (used when DB_DRIVER=mongo)
MONGO_URI=mongodb://127.0.0.1:27017/househunt

# ---- Listing fee ----
# Fee charged = ROOM_RATE * number of rooms (bedrooms, min 1)
ROOM_RATE=100
# One-off upgrade for a video "showcase" listing (waived for Landlord Pro / Agency)
SHOWCASE_FEE=500

# ---- Payments: Pesapal only (M-Pesa, Airtel Money, cards & bank in one secure iframe) ----
# PESAPAL_ENV=sandbox for testing, live for real money.
PESAPAL_ENV=sandbox
PESAPAL_KEY=
PESAPAL_SECRET=
# Optional: pre-registered IPN id. If blank, the server registers one on first use.
PESAPAL_IPN_ID=
# Public HTTPS URLs (must be reachable by Pesapal). The return URL is the page
# shown inside the payment window after paying — it now exists on the server.
PESAPAL_IPN_URL=https://your-domain.com/api/payments/ipn
PESAPAL_CALLBACK_URL=https://your-domain.com/api/payments/pesapal-return
CURRENCY=KES

# ---- Accounts ----
# Long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that can access the admin Command Center (/admin.html)
ADMIN_EMAILS=you@example.com
# Google sign-in (must match the client id in frontend/account.html).
# Admin emails can only sign in with Google or an existing account.
GOOGLE_CLIENT_ID=149109402907-6vgf995mtamqd37vds5meosnl96mbs2e.apps.googleusercontent.com
# Sites allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=https://nestkey.co.ke,https://www.nestkey.co.ke
# Optional: n8n workflow that turns each newly published listing into a social video.
N8N_PROPERTY_WEBHOOK_URL=

# ---- Commission ----
# Our fee on rent/sale payments (0.08 = 8%). Money goes straight to the landlord;
# we record the transaction and invoice this % to the landlord separately.
COMMISSION_RATE=0.08

# --- Added in the security/SEO update ---
# Public site address used for canonical links, sitemap and social previews.
SITE_URL=https://nestkey.co.ke
