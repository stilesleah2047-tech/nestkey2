# ---- Server ----
PORT=4000
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# ---- Database: choose ONE driver ----
# DB_DRIVER=postgres  OR  DB_DRIVER=mongo
DB_DRIVER=postgres

# PostgreSQL (used when DB_DRIVER=postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/househunt

# MongoDB (used when DB_DRIVER=mongo)
MONGO_URI=mongodb://127.0.0.1:27017/househunt

# ---- Listing fee ----
# Fee charged = ROOM_RATE * number of rooms (bedrooms, min 1)
ROOM_RATE=100
# One-off upgrade for a video "showcase" listing (waived for Landlord Pro / Agency)
SHOWCASE_FEE=500

# ---- M-Pesa Daraja (Safaricom) ----
MPESA_ENV=sandbox
MPESA_KEY=
MPESA_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TYPE=paybill
# Public HTTPS URL Safaricom will POST the payment result to:
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

# ---- Pesapal (cards + mobile money, paid on-site via iframe) ----
PESAPAL_ENV=sandbox
PESAPAL_KEY=
PESAPAL_SECRET=
# Optional: pre-registered IPN id. If blank, the server registers one on first use.
PESAPAL_IPN_ID=
# Public HTTPS URLs (must be reachable by Pesapal):
PESAPAL_IPN_URL=https://your-domain.com/api/payments/ipn
PESAPAL_CALLBACK_URL=https://your-domain.com/api/payments/pesapal-return
CURRENCY=KES

# ---- Accounts ----
# Long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that can access the admin Command Center (/admin.html)
ADMIN_EMAILS=you@example.com

# ---- Commission ----
# Our fee on rent/sale payments (0.08 = 8%). Money goes straight to the landlord;
# we record the transaction and invoice this % to the landlord separately.
COMMISSION_RATE=0.08
